# Backend
APP_NAME=研答通
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=./data
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=30000
REQUEST_TIMEOUT_SECONDS=60

# Model provider
MODEL_PROVIDER=volcengine_ark
USE_MOCK_MODEL=false
WUQIONG_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
WUQIONG_API_KEY=
MODEL_LITE=
MODEL_PRO=
MODEL_QA=ep-xxxxxxxxxxxxxxxx
MODEL_SUMMARY=ep-xxxxxxxxxxxxxxxx
MODEL_OUTLINE=ep-xxxxxxxxxxxxxxxx
ROUTE_UPGRADE_CHARS=12000
