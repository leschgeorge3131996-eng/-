# Backend
APP_NAME=yandatong
APP_ENV=development
LOG_LEVEL=INFO
# CORS_ORIGINS also acts as the CSRF Origin allowlist: any state-changing
# (POST/DELETE) request whose Origin/Referer is not in this list is rejected
# with 403 FORBIDDEN_ORIGIN. Wildcards like `https://*.trycloudflare.com` are
# supported — match any subdomain on that scheme. Keep this in sync with your
# actual frontend host.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.trycloudflare.com,https://*.loca.lt
DATA_DIR=./data
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=30000
REQUEST_TIMEOUT_SECONDS=60
DOCUMENT_RETENTION_HOURS=72
SESSION_RETENTION_HOURS=168
SESSION_COOKIE_NAME=yandatong_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
ALPHA_INVITE_CODES=alpha-demo
# Set DEMO_MODE=true for competition/demo builds: frontend auto-creates a session
# on first visit and the invite-code form is hidden. Keep false for real alpha.
DEMO_MODE=false

# Model provider
MODEL_PROVIDER=infinigence_ai
USE_MOCK_MODEL=false
WUQIONG_BASE_URL=https://cloud.infini-ai.com/maas/v1
WUQIONG_API_KEY=
MODEL_LITE=
MODEL_PRO=
# QA default after the 2026-04-30 V6 contract-patch gate.
# Rollback fallback: qwen3-235b-a22b-instruct-2507
MODEL_QA=deepseek-v4-flash
MODEL_SUMMARY=qwen3-235b-a22b-instruct-2507
MODEL_OUTLINE=qwen3-235b-a22b-instruct-2507
ROUTE_UPGRADE_CHARS=12000
